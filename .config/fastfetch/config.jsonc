{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "padding": {
            "right": 3,
            "top": 5
        },
        "color": {
            "1": "blue"
        }
    },

    "display": {
        "separator": " -> ",
        "color": {
            "keys": "blue",
            "title": "blue"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "┌────────────────────────●─────────────────────────┐",
            "outputColor": "blue"
        },
        {
            "type": "title",
            "key": "",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "└────────────────────────●─────────────────────────┘",
            "outputColor": "blue"
        },
        {
            "type": "custom",
            "format": "                                  ",
            "outputColor": "blue"
        },
        {
            "type": "custom",
            "format": "┌────────────────────────●─────────────────────────┐",
            "outputColor": "blue"
        },
        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "host",
            "key": "│ ├  Host",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "│ ├  Kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "│ ├  Uptime"
        },
        {
            "type": "packages",
            "key": "│ ├  Packages"
        },
        {
            "type": "shell",
            "key": "│ └  Shell",
            "format": "{pretty-name}"
        },

        {
            "type": "custom",
            "format": "│",
            "outputColor": "blue"
        },

        {
            "type": "wm",
            "key": " WM"
        },
        /*{
            "type": "theme",
            "key": "│ ├  Theme"
        },
        {
            "type": "icons",
            "key": "│ ├  Icons"
        },*/
        {
            "type": "font",
            "key": "│ ├  Font"
        },
        {
            "type": "cursor",
            "key": "│ ├  Cursor"
        },
        {
            "type": "terminal",
            "key": "│ ├  Terminal"
        },
        {
            "type": "terminalfont",
            "key": "│ └  Terminal Font"
        },
        {
            "type": "custom",
            "format": "│",
            "outputColor": "blue"
        },
        {
            "type": "cpu",
            "key": " CPU"
        },
        {
            "type": "cpuusage",
            "key": "│ ├  Usage"
        },
        {
            "type": "gpu",
            "key": "│ ├  GPU",
            "format": "{name} ({core-usage-num}%)"
        },
        {
            "type": "memory",
            "key": "│ ├  Memory"
        },
        {
            "type": "swap",
            "key": "│ ├  Swap"
        },
        {
            "type": "disk",
            "key": "│ ├  Disk"
        },
        {
            "type": "display",
            "key": "│ └  Display"
        },

        {
            "type": "custom",
            "format": "│",
            "outputColor": "blue"
        },

        {
            "type": "battery",
            "key": " Battery"
        },
        {
            "type": "poweradapter",
            "key": "│ ├  Power"
        },
        {
            "type": "localip",
            "key": "│ ├  IP"
        },
        {
            "type": "locale",
            "key": "│ └  Locale"
        },

        {
            "type": "custom",
            "format": "└────────────────────────●─────────────────────────┘",
            "outputColor": "blue"
        },
    ]
}
