[global]
    ### Display ###
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 180)
    origin = top-right
    offset = (12, 48)
    scale = 0
    notification_limit = 5

    ### Winter palette ###
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = "#454f68"
    background = "#101827"
    foreground = "#dce8f7"

    ### Typography ###
    font = "Blex Nerd Font Mono 10"
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no

    ### Spacing ###
    padding = 12
    horizontal_padding = 14
    separator_height = 2
    gap_size = 8

    ### Icons ###
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark:/usr/share/icons/Adwaita

    ### Progress bars ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    ### Behavior ###
    sort = yes
    idle_threshold = 120
    show_age_threshold = 60
    stack_duplicates = yes
    hide_duplicate_count = false
    sticky_history = yes
    history_length = 20

    ### Click actions ###
    mouse_left_click = do_action
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#101827"
    foreground = "#a9bdd5"
    frame_color = "#526781"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#172338"
    foreground = "#dce8f7"
    frame_color = "#89b4fa"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#291b2b"
    foreground = "#ffe4ec"
    frame_color = "#f38ba8"
    timeout = 0
    default_icon = dialog-warning
